# Used by the Express API (server/) and the backend tests.
# Local values: run `npm run db:start`, then `npm run db:env` and copy
# API_URL, ANON_KEY and SERVICE_ROLE_KEY here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
# Service role bypasses RLS — test setup/teardown only. Never commit a real one.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Express API (server/server.js)
API_PORT=4000
# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
