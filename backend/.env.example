PORT=5000
NODE_ENV=development
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars
# Comma-separated list of allowed browser origins (production), e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional: only used by the (not yet wired-in) Prisma/Supabase layer
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
