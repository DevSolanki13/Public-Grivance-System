// Prisma Schema for JanSewa Public Grievance Redressal System
// Database: PostgreSQL on Supabase

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  password       String
  phone          String?
  role           String      @default("citizen") // citizen, officer, department_head, admin
  address        String?
  departmentId   String?
  departmentName String?
  designation    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  grievancesFiled    Grievance[]    @relation("CitizenGrievances")
  grievancesAssigned Grievance[]    @relation("OfficerGrievances")
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Department {
  id              String      @id
  code            String      @unique
  name            String
  description     String?
  slaHoursDefault Int         @default(48)
  headOfficerId   String?
  headOfficerName String?
  email           String?
  phone           String?
  icon            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  categories Category[]
  grievances Grievance[]

  @@map("departments")
}

model Category {
  id            String     @id
  name          String
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  slaHours      Int        @default(48)
  subcategories String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  grievances Grievance[]

  @@map("categories")
}

model Grievance {
  id                  String     @id @default(cuid())
  complaintId         String     @unique
  citizenId           String
  citizen             User       @relation("CitizenGrievances", fields: [citizenId], references: [id])
  citizenName         String
  citizenEmail        String
  citizenPhone        String?
  categoryId          String
  categoryRel         Category   @relation(fields: [categoryId], references: [id])
  category            String
  subcategoryId       String?    @default("general")
  subcategory         String?
  subject             String
  description         String
  priority            String     @default("MEDIUM")
  status              String     @default("SUBMITTED")
  departmentId        String
  departmentRel       Department @relation(fields: [departmentId], references: [id])
  department          String
  assignedOfficerId   String?
  assignedOfficer     User?      @relation("OfficerGrievances", fields: [assignedOfficerId], references: [id])
  assignedOfficerName String?
  assignedAt          DateTime?
  slaHours            Int        @default(48)
  slaStartedAt        DateTime   @default(now())
  slaDeadline         DateTime
  isOverdue           Boolean    @default(false)
  isEscalated         Boolean    @default(false)
  adminRemark         String?
  evidence            String[]
  resolution          Json?
  verification        Json?
  feedback            Json?
  location            Json
  timeline            Json
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("grievances")
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String     @default("info")
  isRead      Boolean    @default(false)
  grievanceId String?
  grievance   Grievance? @relation(fields: [grievanceId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@map("notifications")
}

model AuditLog {
  id              String     @id @default(cuid())
  action          String
  grievanceId     String?
  grievance       Grievance? @relation(fields: [grievanceId], references: [id], onDelete: SetNull)
  complaintId     String?
  performedBy     String
  performedByRole String
  details         String
  ipAddress       String?
  timestamp       DateTime   @default(now())
  user            User?      @relation(fields: [userId], references: [id])
  userId          String?

  @@map("audit_logs")
}
