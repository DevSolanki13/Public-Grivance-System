# Copy to .env and fill in.
#
# Local development: in backend/ run `npm run start`, then copy API_URL /
# ANON_KEY / SERVICE_ROLE_KEY from `npm run env`.
# Hosted project: Supabase dashboard → Project Settings → API.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shows one-click sign-in buttons for the seeded demo accounts on the login
# page. Only enable this where supabase/seed.sql has been applied.
VITE_ENABLE_DEMO_LOGIN=true

# Used ONLY by the Playwright E2E tests (never bundled into the app,
# because it has no VITE_ prefix). Never commit a real service role key.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Express API base URL. Leave empty in development (Vite proxies /api to
# http://localhost:4000). In production set it to where the API is deployed.
VITE_API_URL=
