{
  "name": "jansewa-public-grievance-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "db:start": "npm run db:start -w backend",
    "db:stop": "npm run db:stop -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:env": "npm run db:env -w backend",
    "test": "npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:all": "npm run lint && npm run test && npm run test:backend && npm run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
